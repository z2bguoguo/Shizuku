    <string name="sdk_blacklist_title">SDK 黑名单</string>
    <string name="sdk_blacklist_summary">选择不再接收 Shizuku Binder 的应用</string>
    <string name="sdk_blacklist_details">选中的包名不再接收 SDK Binder 和连接回调。保存时会停止所有用户下新加入的应用及共享 UID 的应用；共享 UID 会一起屏蔽。此功能不隐藏 Android 系统查询到的安装包、权限或进程。修改后请点击保存。</string>
    <string name="sdk_blacklist_save">保存黑名单</string>
