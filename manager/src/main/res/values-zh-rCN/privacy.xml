    <string name="sdk_blacklist_error">操作失败：%1$s</string>
    <string name="sdk_blacklist_saved">黑名单已保存，新加入的应用已停止。</string>
    <string name="hide_launcher_title">隐藏桌面图标</string>
    <string name="hide_launcher_summary">隐藏桌面入口，不会隐藏已安装包或运行中的服务。</string>
    <string name="hide_launcher_confirm">隐藏后可从应用详情中的“应用内的其他设置”（部分系统支持）进入，或执行：adb shell am start -n %1$s/moe.shizuku.manager.MainActivity 。关闭本开关可恢复图标。</string>
